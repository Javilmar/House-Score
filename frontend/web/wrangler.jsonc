{
  // Worker solo de ficheros estáticos: sirve el build de Vite (dist/), sin código de servidor.
  // Cloudflare Workers Builds: raíz frontend/web, build `npm run build`, deploy `npx wrangler deploy`.
  // VITE_API_URL se define como variable de *build* en el panel (se incrusta al compilar).
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "housescore",
  "compatibility_date": "2026-10-22",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
